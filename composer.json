{
    "name": "laikait/laika-shield",
    "description": "A powerful firewall package for the Laika PHP Framework - IP filtering, rate limiting, SQL injection & XSS detection, and request filtering.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laika",
        "firewall",
        "security",
        "pipeline",
        "ip-blocking",
        "rate-limiting",
        "sql-injection",
        "xss",
        "php"
    ],
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name": "Showket Ahmed",
            "email": "riyadhtayf@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "geoip2/geoip2": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^4.0.2",
        "phpcompatibility/php-compatibility": "dev-develop",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Laika\\Shield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laika\\Shield\\Tests\\": "tests/",
            "Laika\\Route\\": "tests/Stubs/Laika/Route/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laika": {
            "relays": [
                "Laika\\Shield\\Relay\\ShieldRelay"
            ],
            "resources": {
                "pipelines": {
                    "path": "src/Pipeline",
                    "namespace": "Laika\\Shield\\Pipeline",
                    "contract": "Laika\\Route\\Contracts\\PipelineInterface"
                }
            }
        }
    },
    "scripts": {
        "compat": "phpcs --standard=phpcs.xml --report=full"
    }
}
